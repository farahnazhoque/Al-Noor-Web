{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" style=\"scroll-behavior:smooth\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Flogo_v2.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Flogo_v2.png&amp;w=384&amp;q=75 2x\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Ffactory_hero.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=3840&amp;q=75 3840w\" imageSizes=\"(max-width: 900px) 100vw, 40vw\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1tbr5fylw2klk.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1guoti84v2fh3.js\"/><script src=\"/_next/static/chunks/0cbr67yte101v.js\" async=\"\"></script><script src=\"/_next/static/chunks/0iec5q4ack_04.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3y99b256kv_rc.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fml8q_y9s_48.js\" async=\"\"></script><script src=\"/_next/static/chunks/14mumt5_n0xhi.js\" async=\"\"></script><title>Al Noor Paper Mills | Premium Paper Manufacturing</title><meta name=\"description\" content=\"Leading paper mill company in Bangladesh, delivering premium quality paper products for industrial and commercial use.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><nav class=\"top-nav\"><div class=\"container top-nav-inner\"><div class=\"logo\" style=\"display:flex;align-items:center;gap:12px;font-weight:700;font-size:20px;color:var(--ink)\"><img alt=\"Al Noor Logo\" width=\"150\" height=\"48\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;object-fit:contain;mix-blend-mode:multiply\" srcSet=\"/_next/image?url=%2Flogo_v2.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Flogo_v2.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo_v2.png&amp;w=384&amp;q=75\"/><span>Al-Noor <span style=\"color:var(--primary)\">Papers</span></span></div><div class=\"nav-links\"><a href=\"#about\">About</a><div class=\"dropdown\"><a href=\"#products\" style=\"display:inline-flex;align-items:center;gap:4px\">Products<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></a><div class=\"dropdown-menu\"><a href=\"#products\" class=\"dropdown-item\">Industrial Kraft Paper</a><a href=\"#products\" class=\"dropdown-item\">Premium Printing Paper</a><a href=\"#products\" class=\"dropdown-item\">Specialty Grades</a></div></div><div class=\"dropdown\"><a href=\"#units\" style=\"display:inline-flex;align-items:center;gap:4px\">Units<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></a><div class=\"dropdown-menu\"><a href=\"#units\" class=\"dropdown-item\">Unit 1 - Gazipur</a><a href=\"#units\" class=\"dropdown-item\">Unit 2 - Narayanganj</a><a href=\"#units\" class=\"dropdown-item\">Carton &amp; Packaging Plant</a></div></div><div class=\"dropdown\"><a href=\"#investors\" style=\"display:inline-flex;align-items:center;gap:4px\">Investors<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></a><div class=\"dropdown-menu\"><a href=\"#investors\" class=\"dropdown-item\">Financial Statements</a><a href=\"#investors\" class=\"dropdown-item\">Annual Reports</a><a href=\"#investors\" class=\"dropdown-item\">Corporate Governance</a></div></div><a href=\"#contact\" class=\"btn-primary\" style=\"padding:8px 20px;height:40px;font-size:14px;color:var(--on-primary)\">Contact Us</a></div></div></nav><main><section class=\"container hero\"><div class=\"hero-content\"><h1 class=\"display-xl\">Setting the Standard for Premium Paper in Bangladesh</h1><p class=\"body-md\" style=\"font-size:20px;color:var(--muted);max-width:600px\">Al Noor Paper Mills combines decades of expertise with modern technology to deliver world-class paper products for every industry.</p><div class=\"hero-buttons\"><a href=\"#products\" class=\"btn-primary\">Explore Products</a><a href=\"#about\" class=\"btn-secondary\">Our Story</a></div></div><div class=\"hero-image-card\"><img alt=\"Al Noor Factory Exterior\" decoding=\"async\" data-nimg=\"fill\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent\" sizes=\"(max-width: 900px) 100vw, 40vw\" srcSet=\"/_next/image?url=%2Ffactory_hero.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ffactory_hero.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Ffactory_hero.jpg&amp;w=3840&amp;q=75\"/></div></section><section class=\"container\"><div class=\"stats-grid\"><div class=\"stat-item\"><span class=\"stat-number\">25+</span><span class=\"stat-label\">Years of Excellence</span></div><div class=\"stat-item\"><span class=\"stat-number\">50k</span><span class=\"stat-label\">Tons Annual Capacity</span></div><div class=\"stat-item\"><span class=\"stat-number\">100%</span><span class=\"stat-label\">Recycled Options</span></div><div class=\"stat-item\"><span class=\"stat-number\">500+</span><span class=\"stat-label\">B2B Partners</span></div></div></section><section class=\"container section\" id=\"products\"><div style=\"text-align:center;margin-bottom:64px;max-width:700px;margin:0 auto 64px\"><h2 class=\"display-lg\" style=\"margin-bottom:16px\">Our Core Products</h2><p class=\"body-md\" style=\"color:var(--muted);font-size:18px\">Engineered for performance and sustainability, our paper products meet the rigorous demands of global standards.</p></div><div class=\"feature-grid\"><div class=\"feature-card card-red\"><div class=\"card-image-wrapper\"><img alt=\"Industrial Paper Rolls\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fpaper_rolls.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fpaper_rolls.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fpaper_rolls.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fpaper_rolls.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fpaper_rolls.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fpaper_rolls.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fpaper_rolls.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fpaper_rolls.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fpaper_rolls.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fpaper_rolls.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fpaper_rolls.jpg&amp;w=3840&amp;q=75\"/></div><h3 class=\"title-lg\">Industrial Kraft Paper</h3><p class=\"body-md\" style=\"color:rgba(255,255,255,0.9)\">High-strength kraft paper designed for heavy-duty packaging, corrugated boxes, and industrial wrapping applications.</p></div><div class=\"feature-card card-white\"><div class=\"card-image-wrapper\"><img alt=\"Premium Printing Paper\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fquality_control.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fquality_control.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fquality_control.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fquality_control.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fquality_control.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fquality_control.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fquality_control.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fquality_control.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fquality_control.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fquality_control.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fquality_control.jpg&amp;w=3840&amp;q=75\"/></div><h3 class=\"title-lg\">Premium Printing Paper</h3><p class=\"body-md\" style=\"color:var(--muted)\">Bright, smooth, and consistent paper optimized for high-volume commercial printing and publishing houses.</p></div><div class=\"feature-card card-black\"><div class=\"card-image-wrapper\"><img alt=\"Specialty Paper Grades\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fspecialty_paper.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fspecialty_paper.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fspecialty_paper.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fspecialty_paper.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fspecialty_paper.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fspecialty_paper.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fspecialty_paper.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fspecialty_paper.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fspecialty_paper.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fspecialty_paper.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fspecialty_paper.jpg&amp;w=3840&amp;q=75\"/></div><h3 class=\"title-lg\">Specialty Grades</h3><p class=\"body-md\" style=\"color:rgba(255,255,255,0.7)\">Custom-engineered paper solutions for specialized needs, including greaseproof paper and high-absorbency tissue.</p></div></div></section><section class=\"section\" style=\"border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline);background-color:#fff\"><div class=\"container\"><div style=\"text-align:center;margin-bottom:32px\"><span class=\"body-sm\" style=\"text-transform:uppercase;letter-spacing:2px;font-weight:600;color:var(--muted)\">Quality &amp; Standards</span><h3 class=\"title-lg\" style=\"margin-top:8px\">Global Certifications &amp; Accreditations</h3></div><div class=\"accreds-row\"><div class=\"accred-logo\">ISO 9001:2015</div><div class=\"accred-logo\">FSC Certified</div><div class=\"accred-logo\">ISO 14001:2015</div><div class=\"accred-logo\">BSTI Quality</div><div class=\"accred-logo\">Green Industrial</div></div></div></section><section class=\"container section\" id=\"units\"><div style=\"text-align:center;margin-bottom:64px;max-width:700px;margin:0 auto 64px\"><h2 class=\"display-lg\" style=\"margin-bottom:16px\">Our Manufacturing Units</h2><p class=\"body-md\" style=\"color:var(--muted);font-size:18px\">Operating high-capacity plants in major industrial hubs to ensure uninterrupted paper supply across Bangladesh.</p></div><div class=\"units-grid\"><div class=\"unit-card\"><div style=\"position:relative;width:100%;height:220px;border-radius:var(--rounded-md);overflow:hidden;margin-bottom:var(--spacing-md)\"><img alt=\"Al Noor Gazipur Unit 1\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent\" sizes=\"(max-width: 768px) 100vw, 33vw\" srcSet=\"/_next/image?url=%2Fgazipur_unit.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fgazipur_unit.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fgazipur_unit.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fgazipur_unit.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fgazipur_unit.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fgazipur_unit.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fgazipur_unit.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fgazipur_unit.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fgazipur_unit.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fgazipur_unit.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fgazipur_unit.jpg&amp;w=3840&amp;q=75\"/></div><div style=\"display:flex;justify-content:space-between;align-items:center\"><h3 class=\"title-md\">Al Noor Unit 1</h3><span class=\"btn-secondary\" style=\"height:28px;padding:0 12px;font-size:12px;border-radius:var(--rounded-xs)\">Gazipur</span></div><p class=\"body-sm\" style=\"color:var(--muted)\">Our primary newsprint and writing paper production plant. Spanning over 50 acres with state-of-the-art fully automated paper machinery.</p></div><div class=\"unit-card\"><div style=\"position:relative;width:100%;height:220px;border-radius:var(--rounded-md);overflow:hidden;margin-bottom:var(--spacing-md)\"><img alt=\"Al Noor Narayanganj Unit 2\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent\" sizes=\"(max-width: 768px) 100vw, 33vw\" srcSet=\"/_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fnarayanganj_unit.jpg&amp;w=3840&amp;q=75\"/></div><div style=\"display:flex;justify-content:space-between;align-items:center\"><h3 class=\"title-md\">Al Noor Unit 2</h3><span class=\"btn-secondary\" style=\"height:28px;padding:0 12px;font-size:12px;border-radius:var(--rounded-xs)\">Narayanganj</span></div><p class=\"body-sm\" style=\"color:var(--muted)\">Dedicated to industrial kraft paper and cardboard packaging sheets. Located close to the river terminal for convenient transport.</p></div><div class=\"unit-card\"><div style=\"position:relative;width:100%;height:220px;border-radius:var(--rounded-md);overflow:hidden;margin-bottom:var(--spacing-md)\"><div style=\"background-color:var(--surface-soft);width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--muted-soft)\"><svg width=\"64\" height=\"64\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"></polyline><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"></line></svg></div></div><div style=\"display:flex;justify-content:space-between;align-items:center\"><h3 class=\"title-md\">Carton &amp; Packaging Plant</h3><span class=\"btn-secondary\" style=\"height:28px;padding:0 12px;font-size:12px;border-radius:var(--rounded-xs)\">Dhaka</span></div><p class=\"body-sm\" style=\"color:var(--muted)\">A high-precision printing and carton assembly facility catering directly to Bangladesh&#x27;s RMG (Garments) and pharmaceutical export sectors.</p></div></div></section><section class=\"section\" style=\"background-color:var(--surface-soft)\" id=\"about\"><div class=\"container\" style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(400px, 1fr));gap:var(--spacing-xxl);align-items:center\"><div><h2 class=\"display-lg\" style=\"margin-bottom:24px\">Rooted in Quality,<br/>Growing with Purpose.</h2><p class=\"body-md\" style=\"margin-bottom:16px;font-size:18px\">Founded in the heart of Bangladesh&#x27;s industrial zone, Al Noor Paper Mills has grown from a modest operation into one of the country&#x27;s most advanced paper manufacturing facilities.</p><p class=\"body-md\" style=\"margin-bottom:32px;color:var(--muted)\">Our commitment goes beyond just making paper. We are dedicated to sustainable manufacturing processes, minimizing our environmental footprint while maximizing the quality of every sheet that leaves our factory.</p><button class=\"btn-primary\">Learn More About Us</button></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:var(--spacing-lg)\"><div class=\"feature-card card-gray\" style=\"padding:var(--spacing-lg)\"><h3 class=\"title-md\" style=\"margin-bottom:8px\">Eco-Friendly</h3><p class=\"body-sm\" style=\"color:var(--muted)\">We source our raw materials from certified sustainable forests.</p></div><div class=\"feature-card card-white\" style=\"padding:var(--spacing-lg);margin-top:40px\"><h3 class=\"title-md\" style=\"margin-bottom:8px\">Advanced Tech</h3><p class=\"body-sm\" style=\"color:var(--muted)\">Utilizing state-of-the-art machinery for precision and consistency.</p></div></div></div></section><section class=\"container section\" id=\"investors\"><div style=\"text-align:center;margin-bottom:64px;max-width:700px;margin:0 auto 64px\"><h2 class=\"display-lg\" style=\"margin-bottom:16px\">Investor Relations</h2><p class=\"body-md\" style=\"color:var(--muted);font-size:18px\">Providing transparency and trust. Access Al Noor Paper Mills financial statements, corporate governance, and disclosures.</p></div><div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:var(--spacing-lg)\"><div class=\"investor-card\"><h3 class=\"title-md\" style=\"border-bottom:2px solid var(--primary);padding-bottom:12px\">Financial Reports</h3><p class=\"body-sm\" style=\"color:var(--muted)\">Read and download our quarterly and annual financial statements.</p><div class=\"investor-links\"><a href=\"#investors\" class=\"investor-link\">Annual Report <!-- -->2025<!-- -->→</a><a href=\"#investors\" class=\"investor-link\">Q3 Financial Statement →</a><a href=\"#investors\" class=\"investor-link\">Half-Yearly Financials →</a></div></div><div class=\"investor-card\"><h3 class=\"title-md\" style=\"border-bottom:2px solid var(--ink);padding-bottom:12px\">Corporate Governance</h3><p class=\"body-sm\" style=\"color:var(--muted)\">Learn about our Board of Directors, policies, and code of conduct.</p><div class=\"investor-links\"><a href=\"#investors\" class=\"investor-link\" style=\"color:var(--ink)\">Board of Directors →</a><a href=\"#investors\" class=\"investor-link\" style=\"color:var(--ink)\">Compliance &amp; Disclosures →</a><a href=\"#investors\" class=\"investor-link\" style=\"color:var(--ink)\">Shareholding Pattern →</a></div></div><div class=\"investor-card\" style=\"background-color:var(--surface-soft)\"><h3 class=\"title-md\" style=\"border-bottom:2px dashed var(--muted-soft);padding-bottom:12px\">Shareholder Services</h3><p class=\"body-sm\" style=\"color:var(--muted)\">Contact info and investor complains cells details.</p><div class=\"investor-links\"><a href=\"#investors\" class=\"investor-link\">Investor Complaints →</a><a href=\"#investors\" class=\"investor-link\">General Notices →</a><a href=\"#investors\" class=\"investor-link\">IPO Disclosures →</a></div></div></div></section><section class=\"container section\" style=\"text-align:center;padding:100px 0\" id=\"contact\"><div style=\"background-color:var(--surface-soft);border-radius:var(--rounded-xl);padding:80px 40px;max-width:800px;margin:0 auto\"><h2 class=\"display-md\" style=\"margin-bottom:16px\">Ready to Partner with Us?</h2><p class=\"body-md\" style=\"color:var(--muted);margin-bottom:32px;font-size:18px\">Get in touch with our team to discuss your paper manufacturing needs and how we can support your business.</p><button class=\"btn-primary\" style=\"padding:0 40px\">Contact Sales Team</button></div></section></main><!--$--><!--/$--><footer class=\"footer\"><div class=\"container\" style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:32px\"><div><div style=\"display:flex;align-items:center;gap:12px;font-weight:700;font-size:18px;margin-bottom:16px;color:var(--ink)\"><img alt=\"Al Noor Logo\" loading=\"lazy\" width=\"150\" height=\"48\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;object-fit:contain;mix-blend-mode:multiply\" srcSet=\"/_next/image?url=%2Flogo_v2.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Flogo_v2.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo_v2.png&amp;w=384&amp;q=75\"/><span>Al-Noor <span style=\"color:var(--primary)\">Papers</span></span></div>